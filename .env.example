# Fill ONCE on the VM. systemd reuses this file after reboot. Do not re-type keys.
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=4
LIGHTER_API_PRIVATE_KEY=

# 0 = load account + log, no sendTx. 1 = arm on startup (real limits).
ARM=0
DYNAMIC_SPACING=0

# Markets to run in this process (same Lighter account, serialized sendTx)
MARKETS=AUDUSD,NATGAS

# USD per grid level (desk can change live; saved in data/settings.json)
ORDER_NOTIONAL=100
# ORDER_NOTIONAL_NATGAS=100
# ORDER_NOTIONAL_AUDUSD=100

# Status HTTP. Keep 127.0.0.1. Open the desk with SSH -L 8787:127.0.0.1:8787
HOST=127.0.0.1
PORT=8787

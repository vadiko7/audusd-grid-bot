# Lighter mainnet — fill on the VM only. Never commit this file.
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=4
LIGHTER_API_PRIVATE_KEY=

# 0 = load account + log, no sendTx. 1 = arm on startup (real $100 limits).
ARM=0
DYNAMIC_SPACING=0

# Status HTTP. Keep 127.0.0.1 until the Oracle security list is opened.
HOST=127.0.0.1
PORT=8787
